---
// src/pages/kelola-konten/index.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard CMS">
  <div class="cms-container" id="cmsApp">
    <div class="cms-header">
      <h1 class="cms-title">Dashboard Pengelolaan</h1>
      <div id="authStatus" class="auth-status">
        <span class="status-indicator warning"></span>
        <span class="status-text">Belum Autentikasi</span>
      </div>
    </div>

    <!-- Auth Modal -->
    <div id="authModal" class="modal-overlay open">
      <div class="modal-content surface animate-fade-in">
        <div class="modal-header">
          <h2>Autentikasi Akses</h2>
        </div>
        <div class="modal-body">
          <p>Silakan masukkan PIN administrasi (default: sipeka2026).</p>
          <div class="form-group">
            <input type="password" id="authPin" class="form-input" placeholder="Masukkan PIN" />
          </div>
          <p id="authError" class="error-msg" style="display: none;">PIN tidak valid.</p>
        </div>
        <div class="modal-footer">
          <button id="authBtn" class="btn btn-primary w-100">Verifikasi</button>
        </div>
      </div>
    </div>

    <!-- Build Polling Modal -->
    <div id="buildModal" class="modal-overlay">
      <div class="modal-content surface text-center">
        <div class="modal-body">
          <div class="spinner"></div>
          <h3 class="mt-4 mb-2">Memproses Pembaruan</h3>
          <p class="text-muted">Sedang sinkronisasi dengan GitHub Actions...<br/>Mohon jangan tutup jendela ini.</p>
          
          <div class="progress-container mt-4">
            <div id="buildProgress" class="progress-bar"></div>
          </div>
          <p id="buildStatusText" class="mt-2 text-sm text-muted">Menunggu webhook commit...</p>
        </div>
        <div class="modal-footer" id="buildModalFooter" style="display: none;">
          <button id="closeBuildModalBtn" class="btn btn-secondary w-100">Tutup</button>
        </div>
      </div>
    </div>

    <div id="cmsContent" class="cms-tabs-content" style="opacity: 0; pointer-events: none; transition: opacity 0.3s;">
      <!-- Tab 1: Kelola Berita -->
      <section id="tab-berita" class="tab-pane active">
        <div class="flex-between mb-4">
          <h2>Daftar Berita</h2>
          <button id="btnTulisBerita" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Tulis Berita
          </button>
        </div>
        <div class="surface p-4 text-center text-muted">
          <p>Fitur Manajemen Berita via GitHub API (Visual Editor)</p>
          <p class="text-sm">Implementasi penuh membutuhkan endpoint API GitHub dan token PAT di environment variable.</p>
        </div>
      </section>

      <!-- Tab 2: Kelola Tags -->
      <section id="tab-tags" class="tab-pane">
        <h2>Kategori / Tags</h2>
        <div class="surface p-4 text-center text-muted mt-4">
          <p>Fitur Editor <code>src/data/tags.json</code></p>
        </div>
      </section>

      <!-- Tab 3: Kelola Panduan -->
      <section id="tab-panduan" class="tab-pane">
        <h2>Dokumen SOP</h2>
        <div class="surface p-4 text-center text-muted mt-4">
          <p>Fitur Editor <code>src/data/panduan.json</code></p>
        </div>
      </section>
    </div>
  </div>

  <style>
    .cms-container {
      max-width: 1000px;
      margin: 0 auto;
    }
    
    .cms-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border-color);
    }
    
    .cms-title {
      font-size: 1.5rem;
      margin: 0;
    }
    
    .flex-between {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .mb-2 { margin-bottom: 0.5rem; }
    .mb-4 { margin-bottom: 1.5rem; }
    .mt-2 { margin-top: 0.5rem; }
    .mt-4 { margin-top: 1.5rem; }
    .p-4 { padding: 1.5rem; }
    .w-100 { width: 100%; }
    .text-center { text-align: center; }
    .text-muted { color: var(--text-primary); }
    .text-sm { font-size: 0.875rem; }
    
    /* Status Indicator */
    .auth-status {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      padding: 0.375rem 0.75rem;
      background-color: var(--surface-color);
      border: 1px solid var(--border-color);
      border-radius: 9999px;
    }
    
    .status-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }
    
    .status-indicator.warning { background-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2); }
    .status-indicator.success { background-color: #10b981; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2); }
    
    /* Tabs */
    .tab-pane {
      display: none;
      animation: fadeIn var(--transition-fast) forwards;
    }
    
    .tab-pane.active {
      display: block;
    }
    
    /* Modals */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-color: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 99999;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-normal);
      padding: 1rem;
      box-sizing: border-box;
    }
    
    .modal-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }
    
    .modal-content {
      width: 100%;
      max-width: 400px;
      padding: 0;
      overflow: hidden;
      position: relative;
      z-index: 100000;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
    }
    
    .modal-header {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border-color);
    }
    
    .modal-header h2 {
      font-size: 1.25rem;
      margin: 0;
    }
    
    .modal-body {
      padding: 1.5rem;
    }
    
    .modal-footer {
      padding: 1rem 1.5rem;
      background-color: var(--bg-color);
      border-top: 1px solid var(--border-color);
    }
    
    /* Forms */
    .form-group {
      margin-bottom: 1rem;
    }
    
    .form-input {
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      background-color: var(--bg-color);
      color: var(--text-heading);
      font-family: var(--font-primary);
      font-size: 1rem;
      transition: all var(--transition-fast);
      box-sizing: border-box;
    }
    
    .form-input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-light);
    }
    
    .error-msg {
      color: #ef4444;
      font-size: 0.875rem;
      margin-top: -0.5rem;
      margin-bottom: 1rem;
    }
    
    /* Progress */
    .progress-container {
      width: 100%;
      height: 8px;
      background-color: var(--border-color);
      border-radius: 4px;
      overflow: hidden;
    }
    
    .progress-bar {
      height: 100%;
      width: 0%;
      background-color: var(--accent);
      transition: width 0.3s ease;
    }
    
    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid var(--border-color);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin: 0 auto;
    }
    
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Setup Crypto Hashing (SHA-256)
      async function hashSHA256(message: string) {
        const msgBuffer = new TextEncoder().encode(message);                    
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        return hashHex;
      }

      // Expected Hash for "sipeka2026"
      // echo -n "sipeka2026" | sha256sum -> 206b8bd7c170a4a6211d2e13271bc97858c2f1f416c878d655f5f4a7c86e0825
      const EXPECTED_HASH = "206b8bd7c170a4a6211d2e13271bc97858c2f1f416c878d655f5f4a7c86e0825";

      const authModal = document.getElementById('authModal');
      const authPin = document.getElementById('authPin') as HTMLInputElement;
      const authBtn = document.getElementById('authBtn');
      const authError = document.getElementById('authError');
      const cmsContent = document.getElementById('cmsContent');
      const authStatus = document.getElementById('authStatus');

      async function verifyAuth() {
        const pin = authPin.value;
        if (!pin) return;
        
        const hash = await hashSHA256(pin);
        
        // Timing Safe Equal equivalent in client side (simulasi konstan time comparison)
        let isMatch = true;
        if (hash.length !== EXPECTED_HASH.length) isMatch = false;
        
        let diff = 0;
        for (let i = 0; i < Math.min(hash.length, EXPECTED_HASH.length); i++) {
            diff |= hash.charCodeAt(i) ^ EXPECTED_HASH.charCodeAt(i);
        }
        
        if (isMatch && diff === 0) {
          // Success
          authModal?.classList.remove('open');
          if (cmsContent) {
            cmsContent.style.opacity = '1';
            cmsContent.style.pointerEvents = 'auto';
          }
          if (authStatus) {
            authStatus.innerHTML = '<span class="status-indicator success"></span><span class="status-text">Terverifikasi (Admin)</span>';
          }
        } else {
          // Failed
          if (authError) authError.style.display = 'block';
          authPin.value = '';
          authPin.focus();
        }
      }

      authBtn?.addEventListener('click', verifyAuth);
      authPin?.addEventListener('keyup', (e) => {
        if (e.key === 'Enter') verifyAuth();
      });

      // Tabs Logic
      const navItems = document.querySelectorAll('.admin-nav-item[data-tab]');
      const tabPanes = document.querySelectorAll('.tab-pane');

      navItems.forEach(item => {
        item.addEventListener('click', (e) => {
          e.preventDefault();
          const targetTab = item.getAttribute('data-tab');
          
          navItems.forEach(nav => nav.classList.remove('active'));
          item.classList.add('active');
          
          tabPanes.forEach(pane => {
            pane.classList.remove('active');
            if (pane.id === `tab-${targetTab}`) {
              pane.classList.add('active');
            }
          });
        });
      });
    });
  </script>
</AdminLayout>