---
// src/pages/berita/index.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import tagsData from '../../data/tags.json';

const allBerita = await getCollection('berita');
const sortedBerita = allBerita.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function getTagColor(categoryName: string) {
  if (!categoryName) return '#239ba7';
  const tag = tagsData.tags.find(
    t => t.slug.toLowerCase() === categoryName.toLowerCase() || 
         t.name.toLowerCase() === categoryName.toLowerCase() ||
         t.id.toLowerCase() === categoryName.toLowerCase()
  );
  return tag ? tag.color : '#239ba7';
}

function getTagName(categoryName: string) {
  if (!categoryName) return 'Umum';
  const tag = tagsData.tags.find(
    t => t.slug.toLowerCase() === categoryName.toLowerCase() || 
         t.name.toLowerCase() === categoryName.toLowerCase() ||
         t.id.toLowerCase() === categoryName.toLowerCase()
  );
  return tag ? tag.name : categoryName;
}
---

<Layout title="Berita & Arsip - SIPEKA EDU">
  <div class="page-header">
    <div class="container">
      <h1 class="page-title">Berita & Publikasi</h1>
      <p class="page-desc">Arsip informasi, kegiatan, dan edukasi terkait pencegahan kekerasan seksual di lingkungan pendidikan.</p>
    </div>
  </div>

  <div class="container page-content">
    <div class="filter-bar">
      <div class="search-box">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="searchInput" placeholder="Cari berita..." class="search-input" />
      </div>
      
      <div class="tag-filters" id="tagFilters">
        <button class="tag-filter-btn active" data-tag="all">Semua</button>
        {tagsData.tags.map(tag => (
          <button class="tag-filter-btn" data-tag={tag.slug} style={`--tag-color: ${tag.color}`}>
            {tag.name}
          </button>
        ))}
      </div>
    </div>

    <div class="berita-grid" id="beritaGrid">
      {sortedBerita.map(berita => (
        <article class="berita-card surface" data-category={berita.data.category}>
          <a href={`/sipeka-edu/berita/${berita.slug}`} class="berita-img-wrapper">
            {berita.data.coverImage ? (
              <img src={berita.data.coverImage} alt={berita.data.title} class="berita-img" />
            ) : (
              <div class="berita-img-placeholder">SIPEKA EDU</div>
            )}
          </a>
          <div class="berita-content">
            <div class="berita-meta">
              <span 
                class="berita-tag" 
                style={`background-color: ${getTagColor(berita.data.category)}18; color: ${getTagColor(berita.data.category)}; border: 1px solid ${getTagColor(berita.data.category)}40;`}
              >
                {getTagName(berita.data.category)}
              </span>
              <time class="berita-date" datetime={berita.data.date.toISOString()}>
                {berita.data.date.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
            </div>
            <h2 class="berita-title">
              <a href={`/sipeka-edu/berita/${berita.slug}`}>{berita.data.title}</a>
            </h2>
            <p class="berita-excerpt">{berita.data.excerpt}</p>
          </div>
        </article>
      ))}
    </div>
    
    <div id="noResultsMsg" class="no-results hidden">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
      <h3>Tidak ada berita ditemukan</h3>
      <p>Coba gunakan kata kunci lain atau hapus filter kategori.</p>
    </div>
  </div>
</Layout>

<style>
  .page-header {
    background-color: var(--surface-color);
    padding: 4rem 0;
    border-bottom: 1px solid var(--border-color);
    text-align: center;
  }

  html.dark .page-header {
    background-color: var(--bg-color);
  }

  .page-title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .page-desc {
    color: var(--text-primary);
    font-size: 1.125rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .page-content {
    padding: 4rem 1.5rem;
  }

  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .search-box {
    position: relative;
    max-width: 400px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-primary);
  }

  .search-input {
    width: 100%;
    padding: 0.875rem 1rem 0.875rem 2.75rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background-color: var(--surface-color);
    color: var(--text-heading);
    font-family: var(--font-primary);
    font-size: 1rem;
    transition: all var(--transition-fast);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-light);
  }

  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag-filter-btn {
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    border: 1px solid var(--border-color);
    background-color: var(--surface-color);
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .tag-filter-btn:hover {
    border-color: var(--tag-color, var(--accent));
    color: var(--tag-color, var(--accent));
  }

  .tag-filter-btn.active {
    background-color: var(--tag-color, var(--accent));
    color: white;
    border-color: var(--tag-color, var(--accent));
  }

  .tag-filter-btn[data-tag="all"].active {
    background-color: var(--text-heading);
    border-color: var(--text-heading);
  }

  /* Berita Grid - Same as BeritaSection but re-declared for scoping */
  .berita-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .berita-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    transition: transform var(--transition-normal), opacity var(--transition-fast);
  }

  .berita-card.hidden {
    display: none;
  }

  .berita-img-wrapper {
    position: relative;
    padding-top: 56.25%;
    overflow: hidden;
    background-color: var(--bg-color);
  }

  .berita-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .berita-img-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.5rem;
    opacity: 0.3;
  }

  .berita-card:hover .berita-img {
    transform: scale(1.05);
  }

  .berita-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .berita-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  .berita-tag {
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .berita-date {
    color: var(--text-primary);
  }

  .berita-title {
    font-size: 1.25rem;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .berita-title a {
    color: var(--text-heading);
  }

  .berita-title a:hover {
    color: var(--accent);
  }

  .berita-excerpt {
    color: var(--text-primary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .no-results {
    text-align: center;
    padding: 4rem 0;
    color: var(--text-primary);
  }
  
  .no-results svg {
    margin-bottom: 1rem;
    color: var(--border-color);
  }
  
  .no-results h3 {
    margin-bottom: 0.5rem;
  }
  
  .no-results.hidden {
    display: none;
  }

  @media (min-width: 768px) {
    .filter-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const filterBtns = document.querySelectorAll('.tag-filter-btn');
    const articles = document.querySelectorAll('.berita-card');
    const noResultsMsg = document.getElementById('noResultsMsg');
    
    let currentTag = 'all';
    let searchQuery = '';

    function filterArticles() {
      let visibleCount = 0;
      
      articles.forEach((article: any) => {
        const category = article.getAttribute('data-category');
        const title = article.querySelector('.berita-title')?.textContent?.toLowerCase() || '';
        const excerpt = article.querySelector('.berita-excerpt')?.textContent?.toLowerCase() || '';
        
        const matchTag = currentTag === 'all' || category === currentTag;
        const matchSearch = title.includes(searchQuery) || excerpt.includes(searchQuery);
        
        if (matchTag && matchSearch) {
          article.classList.remove('hidden');
          visibleCount++;
        } else {
          article.classList.add('hidden');
        }
      });
      
      if (visibleCount === 0) {
        noResultsMsg?.classList.remove('hidden');
      } else {
        noResultsMsg?.classList.add('hidden');
      }
    }

    // Tag Filter
    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        filterBtns.forEach(b => b.classList.remove('active'));
        target.classList.add('active');
        currentTag = target.getAttribute('data-tag') || 'all';
        filterArticles();
      });
    });

    // Search input
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
      filterArticles();
    });
  });
</script>