---
// src/pages/berita/[slug].astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import tagsData from '../../data/tags.json';

export async function getStaticPaths() {
  const beritaEntries = await getCollection('berita');
  return beritaEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

function getTagData(tagSlug: string) {
  return tagsData.tags.find(t => t.slug === tagSlug) || { name: tagSlug, color: 'var(--accent)' };
}

const tag = getTagData(entry.data.category);
---

<Layout title={`${entry.data.title} - SIPEKA EDU`} description={entry.data.excerpt}>
  <article class="article-wrapper">
    <div class="article-header">
      <div class="container article-container">
        <div class="breadcrumb">
          <a href="/sipeka-edu/">Beranda</a>
          <span class="separator">/</span>
          <a href="/sipeka-edu/berita">Berita</a>
          <span class="separator">/</span>
          <span class="current">{entry.data.title}</span>
        </div>
        
        <span 
          class="article-tag" 
          style={`background-color: ${tag.color}15; color: ${tag.color}; border: 1px solid ${tag.color}40;`}
        >
          {tag.name}
        </span>
        
        <h1 class="article-title">{entry.data.title}</h1>
        
        <div class="article-meta">
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <time datetime={entry.data.date.toISOString()}>
              {entry.data.date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          </div>
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>{entry.data.author || 'Admin SIPEKA'}</span>
          </div>
        </div>
      </div>
    </div>

    {entry.data.coverImage && (
      <div class="container article-container">
        <div class="article-cover">
          <img src={entry.data.coverImage} alt={`Cover for ${entry.data.title}`} />
        </div>
      </div>
    )}

    <div class="container article-container">
      <div class="article-content prose">
        <Content />
      </div>
      
      <div class="article-footer">
        <div class="share-actions">
          <span class="share-label">Bagikan:</span>
          <button class="btn btn-secondary btn-share" data-url={`https://sipeka.pontren.id/berita/${entry.slug}`} aria-label="Copy Link">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            Salin Tautan
          </button>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .article-wrapper {
    padding-bottom: 6rem;
  }

  .article-header {
    background-color: var(--surface-color);
    padding: 3rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }
  
  html.dark .article-header {
    background-color: var(--bg-color);
  }

  .article-container {
    max-width: 800px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-primary);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .breadcrumb .separator {
    color: var(--border-color);
  }

  .breadcrumb .current {
    color: var(--text-heading);
    font-weight: 500;
  }

  .article-tag {
    display: inline-block;
    padding: 0.375rem 1rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .article-title {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.2;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    color: var(--text-primary);
    font-size: 0.9375rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .article-cover {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 3rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    background-color: var(--surface-color);
  }

  .article-cover img {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: cover;
  }

  .article-content {
    font-size: 1.125rem;
  }

  .article-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .share-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .share-label {
    font-weight: 600;
    color: var(--text-heading);
  }

  .btn-share {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const shareBtns = document.querySelectorAll('.btn-share');
    
    shareBtns.forEach(btn => {
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-url');
        if (!url) return;
        
        try {
          await navigator.clipboard.writeText(url);
          const originalHTML = btn.innerHTML;
          btn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Tersalin!
          `;
          setTimeout(() => {
            btn.innerHTML = originalHTML;
          }, 2000);
        } catch (err) {
          console.error('Failed to copy link: ', err);
        }
      });
    });
  });
</script>