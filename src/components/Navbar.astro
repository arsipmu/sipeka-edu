---
// src/components/Navbar.astro
---
<header class="navbar-wrapper">
  <div class="container navbar-container">
    <a href="/sipeka-edu/" class="brand-logo">
      <div class="logo-imgs">
        <img src="/sipeka-edu/img/sipeka.png" alt="Logo SIPEKA" height="40" class="logo-sipeka" />
        <img src="/sipeka-edu/img/3 LOGO.png" alt="Logo Mitra" height="36" class="logo-mitra" />
      </div>
      <span class="brand-text">SIPEKA EDU</span>
    </a>

    <div class="nav-controls">
      <nav class="nav-menu desktop-menu">
        <a href="/sipeka-edu/#profil" class="nav-link">Profil</a>
        <a href="/sipeka-edu/#panduan" class="nav-link">Panduan & SOP</a>
        <a href="/sipeka-edu/berita" class="nav-link">Berita</a>
      </nav>

      <div class="nav-actions">
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle Dark Mode">
          <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        
        <a href="http://sipeka-pontren.id/login" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lapor">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          Lapor
        </a>

        <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Open Menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="mobile-drawer">
    <div class="mobile-drawer-header">
      <span class="brand-text">Menu</span>
      <button id="close-drawer-btn" class="close-drawer-btn" aria-label="Close Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <nav class="mobile-nav-menu">
      <a href="/sipeka-edu/#profil" class="mobile-nav-link">Profil</a>
      <a href="/sipeka-edu/#panduan" class="mobile-nav-link">Panduan & SOP</a>
      <a href="/sipeka-edu/berita" class="mobile-nav-link">Berita</a>
    </nav>
  </div>
  <div id="mobile-overlay" class="mobile-overlay"></div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(var(--surface-color-rgb, 255, 255, 255), 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
    transition: background-color var(--transition-normal), border-color var(--transition-normal);
  }

  html.dark .navbar-wrapper {
    background-color: rgba(40, 48, 70, 0.85); /* #283046 with opacity */
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-heading);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .logo-imgs {
    display: flex;
    align-items: center;
    height: 40px;
    gap: 0.5rem;
  }

  .logo-sipeka {
    height: 100%;
    width: auto;
    object-fit: contain;
  }

  .nav-controls {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-menu {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    color: var(--text-primary);
    font-weight: 500;
    font-size: 0.9375rem;
    padding: 0.5rem 0;
    position: relative;
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--accent);
    transition: width var(--transition-fast);
    border-radius: 2px;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .theme-toggle {
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-primary);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
    background-color: var(--accent-light);
  }

  html.dark .sun-icon { display: block; }
  html.dark .moon-icon { display: none; }
  html:not(.dark) .sun-icon { display: none; }
  html:not(.dark) .moon-icon { display: block; }

  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: var(--text-heading);
    cursor: pointer;
    padding: 0.25rem;
  }

  /* Mobile Drawer Styles */
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: -100%;
    width: 280px;
    height: 100vh;
    background-color: var(--surface-color);
    z-index: 100;
    box-shadow: -4px 0 15px rgba(0, 0, 0, 0.05);
    transition: right var(--transition-normal);
    display: flex;
    flex-direction: column;
  }

  .mobile-drawer.open {
    right: 0;
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .close-drawer-btn {
    background: transparent;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.25rem;
  }

  .mobile-nav-menu {
    display: flex;
    flex-direction: column;
    padding: 1rem 0;
  }

  .mobile-nav-link {
    padding: 1rem 1.5rem;
    color: var(--text-heading);
    font-weight: 500;
    border-bottom: 1px solid var(--border-color);
  }

  .mobile-nav-link:hover {
    background-color: var(--accent-light);
    color: var(--accent);
  }

  .mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 90;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-normal);
    backdrop-filter: blur(4px);
  }

  .mobile-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 768px) {
    .desktop-menu {
      display: none;
    }
    .mobile-menu-btn {
      display: block;
    }
    .btn-lapor span {
      display: none; /* Sembunyikan teks Lapor di mobile ekstrim jika perlu, atau pertahankan */
    }
    .btn-lapor {
      padding: 0.5rem 0.75rem;
    }
  }
</style>

<script>
  // Script client-side murni untuk interaktivitas
  document.addEventListener('DOMContentLoaded', () => {
    // Theme Toggle
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
      }
    });

    // Mobile Drawer
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('close-drawer-btn');
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('mobile-overlay');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    function toggleDrawer() {
      drawer?.classList.toggle('open');
      overlay?.classList.toggle('open');
      document.body.style.overflow = drawer?.classList.contains('open') ? 'hidden' : '';
    }

    mobileBtn?.addEventListener('click', toggleDrawer);
    closeBtn?.addEventListener('click', toggleDrawer);
    overlay?.addEventListener('click', toggleDrawer);
    
    mobileLinks.forEach(link => {
      link.addEventListener('click', toggleDrawer);
    });
  });
</script>