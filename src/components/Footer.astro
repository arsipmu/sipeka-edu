---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---
<footer class="footer-wrapper">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo-imgs">
          <img src="/sipeka-edu/img/sipeka.png" alt="Logo SIPEKA" height="48" class="logo-sipeka" />
          <img src="/sipeka-edu/img/3 LOGO.png" alt="Logo Mitra" height="42" class="logo-mitra" />
        </div>
        <p class="brand-desc">Sistem Pencegahan & Penanganan Kekerasan Seksual terpadu untuk lingkungan pendidikan yang aman dan inklusif.</p>
      </div>
      
      <div class="footer-links">
        <h4 class="footer-heading">Navigasi</h4>
        <ul>
          <li><a href="/sipeka-edu/#profil">Profil Program</a></li>
          <li><a href="/sipeka-edu/#panduan">Panduan & SOP</a></li>
          <li><a href="/sipeka-edu/berita">Arsip Berita</a></li>
        </ul>
      </div>
      
      <div class="footer-links">
        <h4 class="footer-heading">Kontak Terkait</h4>
        <ul>
          <li><a href="http://sipeka-pontren.id" target="_blank" rel="noopener noreferrer">Portal Utama SIPEKA</a></li>
          <li><a href="http://sipeka-pontren.id/login" target="_blank" rel="noopener noreferrer">Masuk ke Sistem</a></li>
          <li><a href="/sipeka-edu/kelola-konten">Kelola Konten SIPEKA</a></li>
        </ul>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; {currentYear} SIPEKA EDU & Universitas Garut. Hak Cipta Dilindungi.</p>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    background-color: var(--surface-color);
    border-top: 1px solid var(--border-color);
    padding: 4rem 0 2rem;
    margin-top: 4rem;
  }
  
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }
  
  .footer-brand .logo-imgs {
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .footer-brand img {
    height: 48px;
    width: auto;
  }
  
  .brand-desc {
    color: var(--text-primary);
    line-height: 1.6;
    max-width: 400px;
  }
  
  .footer-heading {
    font-size: 1.125rem;
    margin-bottom: 1.25rem;
    color: var(--text-heading);
  }
  
  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .footer-links a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  
  .footer-links a:hover {
    color: var(--accent);
  }
  
  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    text-align: center;
    color: var(--text-primary);
    font-size: 0.875rem;
  }
  
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>